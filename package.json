{
  "name": "spatium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "量形之度 / SPATIUM — 数学硬核策略挂机",
  "scripts": {
    "dev": "vite",
    "dev:open": "vite --open",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "play": "vite build && vite preview --open",
    "typecheck": "vue-tsc --noEmit",
    "sim": "node scripts/sim.mjs",
    "balsim:s0": "esbuild scripts/balsim_s0.ts --bundle --format=esm --platform=node --outfile=.tmp/balsim_s0.mjs --log-level=warning && node .tmp/balsim_s0.mjs",
    "smoke": "esbuild src/game/smoke.ts --bundle --format=esm --platform=node --outfile=.tmp/smoke.mjs --log-level=warning && node .tmp/smoke.mjs",
    "test:save": "esbuild scripts/save_compat_test.ts --bundle --format=esm --platform=node --outfile=.tmp/save_compat.mjs --log-level=warning && node .tmp/save_compat.mjs",
    "test:cnf": "esbuild scripts/cnf_test.ts --bundle --format=esm --platform=node --outfile=.tmp/cnf.mjs --log-level=warning && node .tmp/cnf.mjs",
    "test:hered": "esbuild scripts/hered_check.ts --bundle --format=esm --platform=node --outfile=.tmp/hered.mjs --log-level=warning && node .tmp/hered.mjs"
  },
  "dependencies": {
    "break_eternity.js": "^2.1.3",
    "katex": "^0.19.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.6",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.1.0"
  },
  "comment:install": "本机 npm 的 postinstall 会被沙箱阻断，需用 npm install --ignore-scripts；rollup 的平台原生包不会被 optional 依赖自动带上，故显式声明"
}
